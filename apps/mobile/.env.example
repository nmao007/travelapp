# The Elsewhere API (site/server.mjs). Leave this unset while developing: the
# app then uses the server on the computer running Expo (`npm run dev` in
# site/). Once the site is deployed, put its address in apps/mobile/.env:
# EXPO_PUBLIC_API_URL=https://your-project.vercel.app
# To work on server code with a deployed address set, override it in
# .env.local with your computer's server, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3010
