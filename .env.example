NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google map surface. Use a browser/referrer-restricted Maps JavaScript API key.
# Both values are required; without them the app uses OpenFreeMap Liberty.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAP_ID=

# Production discovery requires hosted provider services.
PHOTON_SERVICE_URL=
PLACES_SERVICE_URL=
POI_SERVICE_URL=
