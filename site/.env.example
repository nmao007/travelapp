NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAP_ID=DEMO_MAP_ID
# Supabase project connection. Use the same values as the Next.js app.
# This anon/publishable key is public; never put a service_role key in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Free Basic plan: https://rapidapi.com/aedbx-aedbx/api/aerodatabox/pricing
# Use direct only for a separately purchased AeroDataBox direct subscription.
AERODATABOX_API_KEY=
AERODATABOX_GATEWAY=rapidapi
