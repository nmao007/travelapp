GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAP_ID=DEMO_MAP_ID
# Supabase project connection. Use the same values as the Next.js app.
# This anon/publishable key is public; never put a service_role key in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only; never sent to the browser. Gateway: direct or rapidapi.
AERODATABOX_API_KEY=
AERODATABOX_GATEWAY=direct
